[Unit]
Description=PilzBase autonomous station logger (user service)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/PilzBase
Environment=PILZBASE_CONFIG=%h/PilzBase/config.yaml
ExecStart=/usr/bin/python3 -m pilzbase.app
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
